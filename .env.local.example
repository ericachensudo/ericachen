# ─── Google Maps ─────────────────────────────────────────────────────────────
# Used client-side to render the interactive city map in First Space.
# NEXT_PUBLIC_ prefix is required so Next.js exposes it to the browser.
# See SETUP.md → Google Maps section for how to create and restrict the key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Google My Maps ───────────────────────────────────────────────────────────
# The ID of your public Google My Maps (the part after ?mid= in the share URL).
# See SETUP.md → Google My Maps section for step-by-step instructions.
GOOGLE_MYMAPS_ID=

# ─── Instagram ───────────────────────────────────────────────────────────────
# Long-lived token (valid 60 days, auto-refreshed by the app).
# See SETUP.md → Instagram section for how to get this.
INSTAGRAM_ACCESS_TOKEN=

# ─── TikTok ──────────────────────────────────────────────────────────────────
# From your TikTok for Developers app (developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Set this to your deployed URL + /api/tiktok/callback
# e.g. https://your-site.vercel.app/api/tiktok/callback
# For local dev: http://localhost:3000/api/tiktok/callback
TIKTOK_REDIRECT_URI=http://localhost:3000/api/tiktok/callback

# Filled in automatically after you visit /api/tiktok/connect
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
